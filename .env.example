# ── Sarvam AI (Speech-to-Text) ───────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Oracle Database ───────────────────────────────────────────────────────────
# Format: host:port/service_name  (used by the chat backend for existing features)
ORACLE_DSN=localhost:1521/ORCL
ORACLE_USER=your_db_user
ORACLE_PASSWORD=your_db_password
# SQL agent also reads individual vars (parsed from ORACLE_DSN if not set)
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE=XE
# ORACLE_MAX_ROWS=100

# ── SQL Agent (FAISS + Embeddings) ───────────────────────────────────────
# Directory where sql_agent/main.py writes FAISS indexes (run once to build)
FAISS_OUTPUT_DIR=sql_agent/output
# BGE embedding model for schema vector search
SQL_EMBED_MODEL=BAAI/bge-large-en
# Ollama model used specifically for SQL generation (defaults to OLLAMA_MODEL)
# SQL_OLLAMA_MODEL=mistral

# ── Ollama (LLaMA 3.1) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Seconds to wait for an Ollama response before timing out
OLLAMA_TIMEOUT=60

# ── FastAPI / CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ── Application Database Q&A (XML-based structured queries) ───────────────────
# Base directory containing iDEAL application XML files (users, roles, returns, etc.)
# If not set, the DB Q&A feature is disabled (graceful degradation)
# Example: D:\Repo\Repo5.5 3\Repo5.5\Database
APP_DB_BASE_PATH=

# Admin role ID for access control (default: "101" for iDEAL "Admin User")
# Users with this role_id can execute admin-only DB Q&A queries
APP_DB_ADMIN_ROLE_ID=101

# Enable LLM beautification for DB Q&A responses (default: true)
# When true, uses Ollama to format query results in natural language
APP_DB_ENABLE_BEAUTIFY=true

# Ollama model for beautifying DB Q&A responses (default: phi3:mini)
# Must match a model available in your running Ollama instance
APP_DB_BEAUTIFY_MODEL=phi3:mini
