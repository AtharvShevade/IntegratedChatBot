# ── Application version routing ──────────────────────────────────────────────
# "5.5" (default): single flat repo root, no tenant concept.
# "6.0": tenant-scoped repo root, resolved per-request from tenant_id/domain.
APP_VERSION=5.5

# ── 5.5 repository root (flat layout: BASE_REPO_PATH\DataBase\, \Instance\, \Render\) ──
BASE_REPO_PATH=D:\Repo(new)

# ── 6.0 repository root (contains XML_Tenant.xml + numbered tenant folders) ──
# Effective per-tenant root becomes APP_600_REPO_ROOT\{TenantId}\...
APP_600_REPO_ROOT=D:\Repo6\Repo6

# ── 5.5 instance-generation .NET API (FunPubInsertInstanceLog, session-cookie auth) ──
DOTNET_API_URL=https://localhost:5000
DOTNET_CONTROLLER=CreateInstance
# DOTNET_SESSION_COOKIE=   # optional static fallback; normally forwarded per-request as asp_session

# ── 6.0 instance-generation .NET API (CreateInstanceController.GenerateReportDB, JWT bearer auth) ──
DOTNET_V6_API_URL=https://localhost:7072

# ── Speech-to-Text (Whisper service, remote — same host as the Ollama proxy) ──
# STT is a remote model service, exactly like Ollama: no model, no torch and no
# ffmpeg on the FastAPI host.
# NOTE: the Whisper MODEL is chosen on the SERVICE host, not here -- this
# backend is a thin HTTP client and loads no model. See
# eval/stt/service_reference/.env.example for WHISPER_MODEL.
STT_ENABLED=true
STT_BASE_URL=http://3.109.51.228/whisper-api
# MEASURED on the deployed service: ~14s for any clip up to 30s and ~23s for
# 60s. Cost is per 30s WINDOW, not per second, so short clips are not cheap.
# The model is resident and already int8 -- the ~8s fixed per-request cost is
# language detection (language=None runs an extra encoder pass). 120 is a
# ceiling with headroom, NOT a target.
STT_TIMEOUT=120
# Longest recording accepted. Also enforced in the browser.
STT_MAX_SECONDS=60
STT_MAX_BYTES=10485760
# ui   = send the selected interface language (default; Whisper's own detection
#        is unreliable on short clips — measured 0.35-0.63 confidence on noise)
# auto = let Whisper decide
STT_LANGUAGE_MODE=ui
# Send language/task/initial_prompt. The service deployed today declares only
# `file` and IGNORES these (verified), so they are inert until it is upgraded.
STT_SEND_HINTS=true
# MEASURED: the service serializes requests, so admit only a few at a time.
STT_CONCURRENCY=2
# Whisper initial_prompt with domain vocabulary. OFF until benchmarked: the
# same conditioning that fixes "CIMS_ROR" can also make the model emit terms
# that were never spoken, and it already hallucinates on silence.
STT_VOCABULARY_ENABLED=false

# ── SQL Agent (Oracle DB + models + FAISS retrieval) ─────────────────────────
# NOT configured here. The agent is configured entirely in its own file:
#
#   sql_agent/.env        (copy from sql_agent/.env.example)
#
# That file holds its Oracle credentials (DB_HOST / DB_PORT / DB_SERVICE /
# DB_USER / DB_PASSWORD / DB_MAX_ROWS), both of its Ollama models
# (OLLAMA_MODEL for SQL generation, SELECTOR_MODEL for table selection), its
# embedder (EMBED_MODEL), and its retrieval knobs (EMBEDDING_DIR, TOP_K_*,
# SHORTLIST_K). backend/sql_agent/_bootstrap.py loads it.
#
# Fallback only — if a deployment has no sql_agent/.env, these ORACLE_* names are
# still mapped onto the agent's DB_* names by _bootstrap.py:
# ORACLE_DSN=localhost:1521/ORCL      # host:port/service_name
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE=XE
# ORACLE_USER=your_db_user
# ORACLE_PASSWORD=your_db_password
# ORACLE_MAX_ROWS=100
# SQL_OLLAMA_MODEL=hf.co/defog/sqlcoder-7b-2:Q5_K_M
# SQL_SELECTOR_MODEL=qwen2.5:7b
# SQL_EMBED_MODEL=BAAI/bge-large-en

# ── Ollama (LLaMA 3.1) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Seconds to wait for an Ollama response before timing out
OLLAMA_TIMEOUT=60

# Fast-fail timeout, in seconds, for the conversational-fallback Ollama call only
# (disambiguate_intent / classify_conversational_intent / chat_response) — the path a
# plain question falls into whenever the db_qa regex/keyword classifier misses. Keep
# this well below OLLAMA_TIMEOUT so a miss fails fast into the caller's existing
# fallback instead of hanging the request. See doc/INTENT_GAP_ANALYSIS.md.
OLLAMA_CHAT_FALLBACK_TIMEOUT=12

# Timeout, in seconds, for extract_intent_and_entities()'s LLM call — the FIRST call made
# for any query the db_qa classifier misses, before it can even reach the fallback above.
# Keep short so a miss reaches that fallback quickly instead of the two calls stacking
# into a long combined wait. See doc/INTENT_GAP_ANALYSIS.md.
OLLAMA_EXTRACT_TIMEOUT=10

# ── FastAPI / CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ── Application Database Q&A (XML-based structured queries) ───────────────────
# Base directory containing iDEAL application XML files (users, roles, returns, etc.)
# If not set, the DB Q&A feature is disabled (graceful degradation)
# Example: D:\Repo\Repo5.5 3\Repo5.5\Database
APP_DB_BASE_PATH=

# Admin role ID for access control (default: "101" for iDEAL "Admin User")
# Users with this role_id can execute admin-only DB Q&A queries
APP_DB_ADMIN_ROLE_ID=101

# Enable LLM beautification for DB Q&A responses (default: true)
# When true, uses Ollama to format query results in natural language
APP_DB_ENABLE_BEAUTIFY=true

# Ollama model for beautifying DB Q&A responses (default: phi3:mini)
# Must match a model available in your running Ollama instance
APP_DB_BEAUTIFY_MODEL=phi3:mini
