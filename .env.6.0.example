# Per-version overlay for APP_VERSION=6.0  (copy to .env.6.0 and adjust for this machine).
#
# Loaded automatically AFTER .env whenever .env says APP_VERSION=6.0
# (backend/env_loader.py). Put here only what differs between 5.5 and 6.0;
# secrets (Oracle credentials, JWT keys, ...) stay in .env. Real environment
# variables still win over both files, and an explicit ENV_FILE skips overlays.
# Delete a line to fall back to the value in .env.
#
# .env.6.0 itself is git-ignored (machine-specific paths) - only this example is tracked.

BACKEND_PORT=8002
LOG_DIR=logs_6.0

# 6.0: folder holding XML_Tenant.xml and the numbered tenant folders (1001, ...)
APP_600_REPO_ROOT=D:\Repo6.0

# 6.0 host API used for instance generation, when it differs from .env
# DOTNET_V6_API_URL=

# CORS_ORIGINS=http://localhost:3000,https://idealtest.irisregtech.com
