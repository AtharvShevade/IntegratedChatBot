# .env

# ── APP_VERSION switch ────────────────────────────────────────────────────────
# "5.5" = flat repo root (BASE_REPO_PATH). "6.0" = tenant-scoped repo root
# (APP_600_REPO_ROOT\{TenantId}\...), resolved per-request from tenant_id/domain.
# Toggle by commenting/uncommenting the pair below — keep exactly one active.
# APP_VERSION=5.5
APP_VERSION=6.0


# ── Repository root ───────────────────────────────────────────────────────────
# 5.5: BASE_REPO_PATH=D:\Repo(new)
# BASE_REPO_PATH=D:\RepoCore_5.5
# 6.0: APP_600_REPO_ROOT (contains XML_Tenant.xml + numbered tenant folders)
APP_600_REPO_ROOT=D:\Repo6.0
# ── Instance-generation .NET API ──────────────────────────────────────────────
# 5.5: FunPubInsertInstanceLog, session-cookie auth
# DOTNET_API_URL= http://localhost:5000
# DOTNET_CONTROLLER = CreateInstance
# 6.0: CreateInstanceController.GenerateReportDB, JWT bearer auth
DOTNET_V6_API_URL=https://localhost:7072



OLLAMA_BASE_URL=http://3.109.51.228/OllamaProxy
# Intent & Entity Extraction
OLLAMA_EXTRACT_MODEL=qwen2.5:7b

# Error Explanations
OLLAMA_MODEL=llama3.1:latest

# SQL Generation — moved. The SQL agent is configured entirely in its own file:
#   sql_agent/.env   (models, Oracle credentials, retrieval knobs)
# Nothing here feeds it any more. Setting SQL_OLLAMA_MODEL below would only take
# effect if sql_agent/.env stopped defining OLLAMA_MODEL itself.
# SQL_OLLAMA_MODEL=hf.co/defog/sqlcoder-7b-2:Q5_K_M


OLLAMA_COMPARE_MODEL=llama3.1:latest

# Conversational Fallback (new — code must be updated to read this)
OLLAMA_FALLBACK_MODEL=qwen2.5:7b

OLLAMA_TIMEOUT=300

# ── FastAPI / CORS ───────────────────VITE_API_BASE_URL─────────────────────────────────────────

# Comma-separated list of allowed frontend origins

CORS_ORIGINS=http://localhost:3000,https://idealtest.irisregtech.com,https://3.109.51.228


APP_DB_ADMIN_ROLE_ID=101

# DB Q&A Beautification
APP_DB_ENABLE_BEAUTIFY=false
APP_DB_BEAUTIFY_MODEL=phi3:mini

# VITE_API_BASE_URL=/AIChatBot/api

# ── Oracle — moved to sql_agent/.env (as DB_HOST / DB_PORT / DB_SERVICE /
# DB_USER / DB_PASSWORD / DB_MAX_ROWS) ────────────────────────────────────────
# The SQL agent was the only consumer of these; no other chatbot feature reads
# Oracle directly. Kept commented as the fallback path: if a deployment ever has
# no sql_agent/.env, uncommenting these restores DB access, since
# backend/sql_agent/_bootstrap.py still maps ORACLE_* onto the agent's DB_* names.
# Format: host:port/service_name
# ORACLE_DSN=3.6.209.141:1521/XE
# ORACLE_HOST=3.6.209.141
# ORACLE_PORT=1521
# ORACLE_SERVICE=XE
# ORACLE_USER=SOUTHINDIANBANK
# ORACLE_PASSWORD=southindianbank1123


# -- 6.0 (QCB / idealcrilc) --
DV_DB_HOST_60=65.0.8.231
DV_DB_PORT_60=1521
DV_DB_SERVICE_60=XE
DV_DB_USER_60=idealcrilc
DV_DB_PASSWORD_60=idealcrilc123
DV_IS_SP_TABLE_DATA_ENABLED_60=True
DV_DP_SCHEMA_60=IDEALCRILC

# Authorization enforcement
REQUIRE_AUTH=true
# Set XML_USER_DEPT_ATTR if your XML_User.xml uses a different attribute name (default: DeptId)
# XML_USER_DEPT_ATTR=DeptId


# Refresh repo files more frequently (values in seconds)
RETURNS_TTL_SEC=60       # Returns.xml — every 1 minute
AUTH_TTL_SEC=60          # XML_User / XML_Dept — every 1 minute
INSTANCES_TTL_SEC=30     # XML_InstanceLog — every 30 seconds

AUTHORIZATION_ENABLED=true
# ── Multilingual translation boundary (backend/i18n) ──────────────────────────
# Wraps /chat and /guided:  user language -> English -> existing pipeline ->
# English -> user language.  The English pipeline itself is untouched.
#
# MULTILINGUAL_ENABLED=false makes every request behave byte-for-byte as it did
# before this feature existed: no translation call, no metadata, no new fields.
MULTILINGUAL_ENABLED=true

# THE model seam.  Switching candidates for the fair A/B comparison is this one
# line and nothing else -- same code, same prompt, same masking, same tests.
# TRANSLATION_MODEL=qwen3:14b
# TRANSLATION_MODEL=gemma4:31b

# Blank inherits OLLAMA_BASE_URL.  Set only when the translation model is served
# somewhere other than the app's own models.  NOTE: a translator on a dedicated
# endpoint and one on the shared proxy are NOT latency-comparable.
TRANSLATION_BASE_URL=

# Deliberately NOT OLLAMA_TIMEOUT (300s) -- this call is on the user-facing path.
# Raised from 60 after measuring: Arabic completes in ~41s but HINDI needs
# >60s on qwen3:14b over the shared proxy and timed out 4 times out of 4,
# silently falling back to English. 150 is what makes Hindi work at all.
# NOTE the trade-off: this is also the ceiling a user can wait on /chat.
TRANSLATION_TIMEOUT=150
TRANSLATION_TEMPERATURE=0
# -1 = unbounded.  llm_service pins num_predict at 256 and truncates silently.
TRANSLATION_NUM_PREDICT=-1
# Budget for what actually reaches the model, applied PER FIELD after the
# catalogue has resolved everything it can. Fields that do not fit stay
# English; the rest of the response is still localized.
# A 3-error formula card needs ~2,200 chars of genuine prose (the rest is
# catalogued or derived), so 2000 left every error card English.
TRANSLATION_MAX_CHARS=4000
# How many translation calls may be in flight at once. The proxy shares one
# model, so a wide fan-out slows every call and makes the queued ones spend
# their whole timeout waiting. Measured on a 3-error formula card (11 calls):
#   unbounded -> 4 timeouts, 4 -> 8 timeouts (hi), 2 -> 2 timeouts.
TRANSLATION_CONCURRENCY=2
SUPPORTED_LANGUAGES=en,fr,ar,hi

# ── /compare-summary override: its own model, same shared proxy ────────────
# The Comparative Analysis AI narrative is several sentences long -- qwen3:14b
# reliably exceeded even a 180s budget on it over the shared proxy (measured
# ReadTimeout at ~200-205s three times running). Benchmarked aya-expanse:8b on
# the same realistic narrative (en->hi/fr/ar, short + long): 57-157s, every
# [[E#]] placeholder preserved. Every OTHER translation call (/chat, /guided,
# ...) keeps using TRANSLATION_MODEL (qwen3:14b) above, unaffected.
COMPARE_SUMMARY_TRANSLATION_MODEL=aya-expanse:8b
# Same shared proxy as OLLAMA_BASE_URL/TRANSLATION_BASE_URL -- aya-expanse:8b
# is now pulled there too. Set this separately only if it is ever moved to a
# dedicated host.
COMPARE_SUMMARY_TRANSLATION_BASE_URL=http://3.109.51.228/OllamaProxy

# ── /compare-execute override: same model, its OWN timeout ──────────────────
# /compare-execute's response can be much larger than an ordinary /chat reply
# (comparison card + error_details[], up to ~50 protected entities) and was
# inheriting the general TRANSLATION_TIMEOUT (150s) purely because it called
# translate_outbound() with no override. Measured in production: this exact
# response shape reliably hit ReadTimeout at ~150s on aya-expanse:8b, in both
# French and Hindi, while the comparison computation itself took 3s. This
# does NOT change TRANSLATION_MODEL -- only gives this one endpoint more time
# and the same PlaceholderSafeTranslator guardrail /compare-summary uses.
COMPARE_EXECUTE_TRANSLATION_TIMEOUT=240

# ── Error explanations (/explain-category): batched translation ────────────
# Every prose fragment inside every error card (heading, text, each bullet,
# each locator label) used to be its own translation call, bounded only by
# TRANSLATION_CONCURRENCY -- a report with several errors could fan out into
# dozens of small calls. These now batch whole error_details[] objects
# together, one call per batch, with their own timeout budget.
ERROR_EXPLANATION_TRANSLATION_BATCH_SIZE=3
ERROR_EXPLANATION_TRANSLATION_TIMEOUT=180

# ── Speech-to-Text (Whisper service, remote — same host as the Ollama proxy) ──
# STT is a remote model service, exactly like Ollama: no model, no torch and no
# ffmpeg on the FastAPI host.
STT_ENABLED=true
STT_BASE_URL=http://3.109.51.228/whisper-api
# MEASURED on the deployed service: ~14s for any clip up to 30s and ~23s for
# 60s. Cost is per 30s WINDOW, not per second, so short clips are not cheap.
# The model is resident and already int8 -- the ~8s fixed per-request cost is
# language detection (language=None runs an extra encoder pass). 120 is a
# ceiling with headroom, NOT a target.
STT_TIMEOUT=120
# Longest recording accepted. Also enforced in the browser.
STT_MAX_SECONDS=60
STT_MAX_BYTES=10485760
# ui   = send the selected interface language (default; Whisper's own detection
#        is unreliable on short clips — measured 0.35-0.63 confidence on noise)
# auto = let Whisper decide
STT_LANGUAGE_MODE=ui
# Send language/task/initial_prompt. The service deployed today declares only
# `file` and IGNORES these (verified), so they are inert until it is upgraded.
STT_SEND_HINTS=true
# MEASURED: the service serializes requests, so admit only a few at a time.
STT_CONCURRENCY=2
# Whisper initial_prompt with domain vocabulary. OFF until benchmarked: the
# same conditioning that fixes "CIMS_ROR" can also make the model emit terms
# that were never spoken, and it already hallucinates on silence.
STT_VOCABULARY_ENABLED=false
 