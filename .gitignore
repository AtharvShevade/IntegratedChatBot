# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/
.venv/
venv/
env/

# ── Node / frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Test / coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── sql_agent (vendored SQL agent checkout) ───────────────────────────────────
# Its own nested git metadata — the agent is a clone, not a submodule, so this
# keeps the outer repo from seeing it.
sql_agent/.git/
# Measurement baselines / ad-hoc reports; nothing in the pipeline reads them.
sql_agent/scratch/
# Hallucination logs written at generation time when SQL stays invalid.
sql_agent/eval/results/
# Sensitive extracted schema data. NOTE: the FAISS indexes and schema.json under
# embedding_building/ are deliberately NOT ignored — the chatbot reads them at
# runtime (EMBEDDING_DIR) and they are rebuilt only via embedding_building/.
sql_agent/data/.json-formatted/

# ── db_qa intent-exemplar embedding index (generated — rebuild via
#    `python -m backend.db_qa.intents.embedding_index`) ───────────────────────
backend/db_qa/intents/output/*.faiss
backend/db_qa/intents/output/*.pkl

# ── Temporary audio files (recorded by speech input) ─────────────────────────
*.wav

# ── Local databases ───────────────────────────────────────────────────────────
*.db
*.sqlite

# ── Sentence-transformer model cache ──────────────────────────────────────────
sentence_transformers_cache/
