# Whisper STT SERVICE configuration.
#
# This file belongs to the SERVICE HOST (the box running the Whisper API), NOT
# to the chatbot backend. backend/stt/ is a thin HTTP client and never loads a
# model, so putting WHISPER_* in the chatbot's .env would have no effect and
# would imply otherwise.
#
#   chatbot .env            -> STT_BASE_URL, STT_TIMEOUT, STT_LANGUAGE_MODE, ...
#   service host (this)     -> WHISPER_MODEL, WHISPER_CPU_THREADS, ...

# ── Model ─────────────────────────────────────────────────────────────────────
# Supported values: large-v3-turbo | large-v3 | medium
# Validated at startup: anything else fails immediately with a message naming
# the allowed values, rather than dying inside faster-whisper as a HuggingFace
# 404/401 several seconds later.
#
# Omit the variable entirely, or leave it empty, to get the default
# (large-v3-turbo) and today's behaviour exactly.

# Production default. Do not change without a benchmark.
WHISPER_MODEL=large-v3-turbo

# Accuracy candidate. large-v3-turbo's own parent: same 32-layer encoder, but
# a full 32-layer decoder instead of turbo's distilled 4-layer one. Turbo's
# distillation is known to cost more accuracy on some languages than others;
# this is the ceiling it was distilled from. Expect noticeably higher latency
# per request (full decoder, ~2x turbo's parameter count) in exchange.
# WHISPER_MODEL=large-v3

# Latency candidate. Measured 1.45x faster than turbo on English with
# semantically identical transcripts -- but NOT yet validated on French,
# Arabic or Hindi, which is where medium is weakest.
# WHISPER_MODEL=medium

# ── Everything below is UNCHANGED and must stay pinned while benchmarking ─────
# Changing more than one variable at a time makes the comparison meaningless.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_BEAM_SIZE=5
WHISPER_VAD=false
