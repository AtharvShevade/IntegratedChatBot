# Per-version overlay for APP_VERSION=5.5  (copy to .env.5.5 and adjust for this machine).
#
# Loaded automatically AFTER .env whenever .env says APP_VERSION=5.5
# (backend/env_loader.py). Put here only what differs between 5.5 and 6.0;
# secrets (Oracle credentials, JWT keys, ...) stay in .env. Real environment
# variables still win over both files, and an explicit ENV_FILE skips overlays.
# Delete a line to fall back to the value in .env.
#
# .env.5.5 itself is git-ignored (machine-specific paths) - only this example is tracked.

BACKEND_PORT=8001
LOG_DIR=logs_5.5

# 5.5: one flat repository root (DataBase\, Instance\, Json\ ...)
BASE_REPO_PATH=D:\RepoCore_5.5

# Browser origins allowed to call the backend (optional - only if it differs from .env)
# CORS_ORIGINS=http://localhost:3000,https://idealtest.irisregtech.com
