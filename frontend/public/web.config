
<configuration>
 <system.webServer>
  <rewrite>
   <rules>

    <rule name="FastAPI Reverse Proxy" stopProcessing="true">

     <match url="^api/(.*)" />

     <action
        type="Rewrite"
        url="http://127.0.0.1:8002/{R:1}"
        appendQueryString="true" />

    </rule>

   </rules>

  </rewrite>

  <!--
    M-22: security headers.

    frame-ancestors (and the legacy X-Frame-Options fallback) MUST allow the
    .NET host(s) that legitimately embed this app in an iframe: it is NOT
    a standalone site. 'self' covers same-origin embedding (the production
    deployment serves this app and the .NET host's reverse-proxied API under
    the same domain); the explicit https origin below is the known test
    deployment. Add further trusted .NET hosts here, one per deployment.
    Do NOT widen this to '*' or drop it, and do NOT add a plain-http origin.

    The CSP intentionally allows 'unsafe-inline' for style-src (React sets
    inline style attributes at runtime) and the Google Fonts host actually
    used by index.html. connect-src is 'self' only because every backend
    call goes through the same-origin "/api" reverse-proxy rule above, never
    directly to a different host from the browser.
  -->
  <httpProtocol>
   <customHeaders>
    <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'self' https://idealtest.irisregtech.com; base-uri 'self'; form-action 'self'" />
    <add name="X-Content-Type-Options" value="nosniff" />
    <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
    <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
    <!--
      X-Frame-Options is a legacy fallback for browsers that ignore
      frame-ancestors. ALLOW-FROM is obsolete/unsupported in modern browsers,
      so this is deliberately omitted rather than set to DENY/SAMEORIGIN,
      which would break the legitimate iframe embedding that frame-ancestors
      above already governs correctly in every current browser.
    -->
   </customHeaders>
  </httpProtocol>
 </system.webServer>
</configuration>