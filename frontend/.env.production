# Production environment — used by `npm run build`
# Requests from the browser go through the IIS reverse proxy path on the same domain.


VITE_API_BASE_URL=/AIChatBot/api
# VITE_API_BASE_URL=/AiChatBot6.0/api

# L-19: the IIS virtual directory this build is served under (Vite's `base`,
# used for all built asset URLs). Was hardcoded in vite.config.js; set here
# instead so a 5.5-style vs 6.0-style deployment path change no longer needs
# a source edit. Keep this in sync with the deployment's actual virtual
# directory name/casing -- it is independent of VITE_API_BASE_URL above
# (API routing) and does not change the existing /AIChatBot/api behavior.

VITE_BASE_PATH=/AiChatbot/
# VITE_BASE_PATH=/AiChatBot6.0/

# M-23: comma-separated origins allowed to send this app postMessage
# (CHATBOT_AUTH/CHATBOT_LANG/CHATBOT_LOGOUT). Defaults to this app's own
# origin when unset, which covers same-origin embedding behind the IIS
# reverse proxy above. Set explicitly if the .NET host embeds this app from
# a different origin in this deployment, e.g.:
VITE_TRUSTED_PARENT_ORIGINS=https://idealtest.irisregtech.com
