# Frontend settings for APP_VERSION=5.5 - selected automatically by vite.config.js
# when the repo's root .env says APP_VERSION=5.5. No secrets here (tracked in git).
#
# These override frontend/.env.development / .env.production for the keys listed.

# `npm run dev`: the 5.5 backend (BACKEND_PORT in .env.5.5)
VITE_API_BASE_URL_DEV=http://127.0.0.1:8001
VITE_TRUSTED_PARENT_ORIGINS_DEV=http://localhost:5000,https://localhost:5173

# `npm run build`: served by IIS under /AiChatbot/, API through the /AIChatBot/api reverse proxy
VITE_API_BASE_URL_PROD=/AIChatBot/api
VITE_TRUSTED_PARENT_ORIGINS_PROD=https://idealtest.irisregtech.com,https://idealtest.irisregtech.com:8443,https://idealdemo.irisregtech.com

VITE_BASE_PATH=/AiChatbot/

# dist/web.config forwards /api to this backend port (must equal BACKEND_PORT in .env.5.5)
BACKEND_PORT=8001
