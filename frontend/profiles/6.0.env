# Frontend settings for APP_VERSION=6.0 - selected automatically by vite.config.js
# when the repo's root .env says APP_VERSION=6.0. No secrets here (tracked in git).
#
# These override frontend/.env.development / .env.production for the keys listed.

# `npm run dev`: the 6.0 backend (BACKEND_PORT in .env.6.0)
VITE_API_BASE_URL_DEV=http://127.0.0.1:8002
VITE_TRUSTED_PARENT_ORIGINS_DEV=http://localhost:5000,https://localhost:5173

# `npm run build`: served by IIS under /AiChatBot6.0/, API through the /AiChatBot6.0/api reverse proxy
VITE_API_BASE_URL_PROD=/AiChatBot6.0/api
VITE_TRUSTED_PARENT_ORIGINS_PROD=https://idealtest.irisregtech.com,https://idealtest.irisregtech.com:8443,https://idealdemo.irisregtech.com,https://idealdemo.irisregtech.com,https://idealdemo.irisregtech.com/WebApi6.0,https://idealdemo.irisregtech.com/WebiDEAL
VITE_BASE_PATH=/AiChatBot6.0/

# dist/web.config forwards /api to this backend port (must equal BACKEND_PORT in .env.6.0)
BACKEND_PORT=8002
