# Development environment — used by `npm run dev` (Vite proxy handles the routing)
VITE_API_BASE_URL=http://127.0.0.1:8001

# M-23: local .NET host origin, confirmed from this repo's own .env
# (DOTNET_API_URL=http://localhost:5000) -- NOT guessed, NOT the production
# origin, NOT a wildcard. The chatbot dev server runs on http://localhost:3000
# (vite.config.js server.port) while the local .NET app runs on a different
# port (5000), so the M-23 postMessage origin check's default same-origin
# fallback (window.location.origin) never matches locally and silently
# rejects every CHATBOT_LANG/CHATBOT_AUTH/CHATBOT_LOGOUT message from the
# local .NET host. This does not weaken the check -- it is still an exact,
# single, non-wildcard allowlist entry.
VITE_TRUSTED_PARENT_ORIGINS=http://localhost:5000
