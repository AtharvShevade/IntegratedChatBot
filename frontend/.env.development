# Development environment — used by `npm run dev` (Vite proxy handles the routing)
VITE_API_BASE_URL=http://127.0.0.1:8001

# M-23: local .NET host origin(s), confirmed from this repo's own .env
# (DOTNET_API_URL=http://localhost:5000) -- NOT guessed, NOT the production
# origin, NOT a wildcard. The chatbot dev server runs on http://localhost:3000
# (vite.config.js server.port) while the local .NET app runs on a different
# port (5000), so the M-23 postMessage origin check's default same-origin
# fallback (window.location.origin) never matches locally and silently
# rejects every CHATBOT_LANG/CHATBOT_AUTH/CHATBOT_LOGOUT message from the
# local .NET host. This does not weaken the check -- it is still an exact,
# comma-separated allowlist (no wildcard).
#
# https://localhost:5173 added for local 6.0 testing: the 6.0 host app
# (WebiDEALReact dashboard, e.g. /dashboard/xbrlgeneration) runs there and
# sends the CHATBOT_AUTH postMessage carrying the JWT used by
# call_generate_api_v6(). Without this origin in the allowlist, the chatbot
# silently drops CHATBOT_AUTH, the JWT never populates, and 6.0 instance
# generation through the chatbot fails with "No JWT provided" even though
# 5.5's login_id/asp_session-based flow is unaffected.
VITE_TRUSTED_PARENT_ORIGINS=http://localhost:5000,https://localhost:5173
